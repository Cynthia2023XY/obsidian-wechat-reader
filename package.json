{
  "name": "wechat-reader",
  "version": "0.2.2",
  "private": true,
  "description": "微信公众号订阅、全文阅读与本地 RSS 导出",
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.runtime.json && node esbuild.config.mjs",
    "test": "vitest run",
    "test:companion": "node scripts/test-runtime.mjs",
    "package:companion": "node scripts/build-runtime.mjs",
    "deploy:test": "node scripts/deploy-test.mjs",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:legacy": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py' -v",
    "test:package": "node scripts/smoke-package.mjs",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@eslint/json": "0.14.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.30.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "26.1.0",
    "obsidian": "1.14.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "linkedom": "0.18.12",
    "playwright-core": "1.56.0",
    "turndown": "^7.2.0"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "overrides": {
    "moment": "^2.31.0"
  }
}
